# Brand95 OS environment configuration.
# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL — durable application source of truth.
DATABASE_URL="postgresql://brand95:brand95@localhost:5432/brand95_dev"

# Used by integration tests (separate database so tests can truncate freely).
TEST_DATABASE_URL="postgresql://brand95:brand95@localhost:5432/brand95_test"

# --- Integrations (all optional; adapters fall back to mock mode when unset) ---

# OpenAI — agent orchestration and structured generation.
OPENAI_API_KEY=""

# Airtable — optional operational interface / imports.
AIRTABLE_API_KEY=""

# Google (Gmail, Drive, Calendar) — OAuth client credentials.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Shopify — storefront integration.
SHOPIFY_SHOP_DOMAIN=""
SHOPIFY_ADMIN_API_TOKEN=""
SHOPIFY_WEBHOOK_SECRET=""
