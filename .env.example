# Brand95 OS environment configuration.
# Copy to .env and fill in real values. Never commit .env.

# ---------------------------------------------------------------------------
# PostgreSQL — durable application source of truth.
#
# Option A: local Postgres (set both URLs to the same value)
DATABASE_URL="postgresql://brand95:brand95@localhost:5432/brand95_dev"
DIRECT_URL="postgresql://brand95:brand95@localhost:5432/brand95_dev"
#
# Option B: Supabase (recommended hosted setup — Supabase IS Postgres).
# Copy both URLs from your Supabase dashboard: Connect → ORMs → Prisma.
#   DATABASE_URL = the "Transaction pooler" URL (port 6543) + "?pgbouncer=true"
#   DIRECT_URL   = the "Direct connection" URL (port 5432)
# Example:
# DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-1-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres"
# ---------------------------------------------------------------------------

# Used by integration tests (separate database so tests can truncate freely).
# Point this at a disposable database — NEVER at production/Supabase.
TEST_DATABASE_URL="postgresql://brand95:brand95@localhost:5432/brand95_test"

# --- Integrations (all optional; adapters fall back to mock mode when unset) ---

# OpenAI — agent orchestration and structured generation.
OPENAI_API_KEY=""

# Airtable — optional operational interface / imports.
AIRTABLE_API_KEY=""

# Google (Gmail, Drive, Calendar) — OAuth client credentials.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Shopify — storefront integration.
SHOPIFY_SHOP_DOMAIN=""
SHOPIFY_ADMIN_API_TOKEN=""
SHOPIFY_WEBHOOK_SECRET=""
