# Jarvis Command Center
# Path to the SQLite database (created on `jarvis init`)
JARVIS_DB=./data/jarvis.db
# Dashboard port for `jarvis serve`
JARVIS_PORT=4795
# Founder identity used in the audit log
JARVIS_FOUNDER=dex

# Talk to Jarvis (dashboard chat + `jarvis chat`). Needs an Anthropic API key.
ANTHROPIC_API_KEY=
# Model for chat. Default claude-opus-5. Use claude-haiku-4-5 for cheapest/fastest, claude-sonnet-5 for middle ground.
JARVIS_MODEL=claude-opus-5
# Effort: low (fastest, default for chat) | medium | high. The "deep" toggle in the UI uses high.
JARVIS_EFFORT=low
# Fast mode (Opus 5 / Opus 4.8 only, ~2.5x output speed, premium pricing). 1 to enable.
JARVIS_FAST=0
